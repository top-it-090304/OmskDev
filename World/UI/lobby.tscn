[gd_scene load_steps=2 format=3 uid="uid://lobby_scene"]

[ext_resource type="Script" path="res://World/UI/lobby.gd" id="1_lobby"]

[node name="Lobby" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_lobby")

[node name="VBoxContainer" type="VBoxContainer" parent="."]
anchor_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -150.0
offset_top = -120.0
offset_right = 150.0
offset_bottom = 120.0
theme_override_constants/separation = 12
alignment = 1

[node name="TitleLabel" type="Label" parent="VBoxContainer"]
text = "Лобби"
horizontal_alignment = 1

[node name="HBoxContainer" type="HBoxContainer" parent="VBoxContainer"]
alignment = 1

[node name="id_prefix" type="Label" parent="VBoxContainer/HBoxContainer"]
text = "Ваш ID: "

[node name="my_id_label" type="Label" parent="VBoxContainer/HBoxContainer"]
text = "—"

[node name="status_label" type="Label" parent="VBoxContainer"]
text = "Статус: ..."
horizontal_alignment = 1

[node name="players_label" type="Label" parent="VBoxContainer"]
text = "Игроки: 0"
horizontal_alignment = 1

[node name="start_button" type="Button" parent="VBoxContainer"]
text = "Начать игру"
custom_minimum_size = Vector2(200, 40)
disabled = true
visible = false

[connection signal="pressed" from="VBoxContainer/start_button" to="." method="_on_start_button_pressed"]
