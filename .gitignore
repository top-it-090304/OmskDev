# --- Godot 4 ---
# Кэш редактора, импортированные ассеты, шейдерный кэш, UID-кэш и т.д.
.godot/

# Сборки под Android (Gradle / APK вывод)
/android/
.gradle/

# Локальные экспорты (если появятся в корне проекта)
*.apk
*.aab
*.ipa
*.exe
*.pck
*.zip

# Раскомментируйте, если пресеты содержат секреты (keystore, пароли) и вы
# храните в репозитории только шаблон без чувствительных данных:
# export_presets.cfg

# --- Сгенерированные / вспомогательные дампы (не часть игры) ---
project_context.txt
scripts_only.txt

# --- ОС и редакторы ---
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp
*.swo

# JetBrains / Rider
.idea/

# --- Прочее ---
*.log
*.tmp
*.bak

# Mono / C# (если когда-нибудь включите C#-модули)
.mono/
data_*/
mono_crash.*.json
